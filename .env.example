# Copiar a .env y rellenar. NO poner valores reales en este archivo (se versiona).

# Requerida. Header x-api-key que deben mandar los consumidores (portfolio).
# Debe coincidir con MARKDOWN_TRANSFORMER_API_KEY en el .env de portfolio.
API_KEY=

# Opcional. Habilita descripción de imágenes vía Gemini.
# Sin ella, las imágenes se convierten igual pero sin descripción.
GEMINI_API_KEY=

# Opcional. Modelo de Gemini. Default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional. Límite de tamaño de archivo en MB. Default: 20
MAX_FILE_SIZE_MB=20
